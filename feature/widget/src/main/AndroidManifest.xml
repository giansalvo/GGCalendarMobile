<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".agenda.AgendaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_agenda_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info" />
        </receiver>

        <receiver
            android:name=".month.MonthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_month_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_widget_info" />
        </receiver>

        <!-- A new day, or the clock or the time zone changed: the widgets show another "today". -->
        <receiver
            android:name=".WidgetTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- The language of the phone, or of this app only (Android 13 and later), changed: the texts of the widgets are in it. -->
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.APPLICATION_LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
